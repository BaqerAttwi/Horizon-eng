PORT=3000
CLIENT_URL=https://your-domain.example
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=horizonlb
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string
# Owner password — used on first startup to seed the admin account
OWNER_PASSWORD=
COOKIE_SECURE=true

# HTTPS / TLS (production)
# Terminate HTTPS at your hosting provider or reverse proxy.
# Express listens over HTTP behind that proxy; KEY_PATH/CERT_PATH are not used.
# Set TRUST_PROXY=1 only when there is exactly one trusted proxy in front of Express.
# TRUST_PROXY=1

# Email / Resend (notifications)
# Sign up at https://resend.com, add your verified domain, then set:
# RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@app.hps-leb.com

# OneDrive attachment storage (CRM Files tab) — Microsoft Graph, delegated
# auth for a personal Microsoft account. Requires an Azure app registration
# (Web platform, "personal Microsoft accounts" supported, delegated
# permissions Files.ReadWrite + offline_access + User.Read). An owner then
# connects the account once from the Files tab — no admin consent needed,
# no tenant ID. Without these set, uploads fall back to local disk storage.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# ONEDRIVE_FOLDER=Horizon LB Attachments
# SERVER_URL must exactly match this app's real origin — it's used to build
# the OAuth redirect URI, which must also be registered in the Azure app's
# "Redirect URIs" list under Authentication. In production this is the same
# as CLIENT_URL (frontend + backend share one origin); in local dev it's the
# backend's own port, not the Vite dev server's.
# SERVER_URL=http://localhost:3000
