PORT=3000
CLIENT_URL=http://your-server-ip-or-domain
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=horizonlb
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string
# Owner password — used on first startup to seed the admin account
OWNER_PASSWORD=
COOKIE_SECURE=false

# HTTPS / TLS (production)
# Set KEY_PATH and CERT_PATH below to enable Express HTTPS directly:
# KEY_PATH=/etc/ssl/private/key.pem
# CERT_PATH=/etc/ssl/certs/cert.pem

# Email / SMTP (notifications)
# Without these, email notifications are disabled (in-app still work)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com
